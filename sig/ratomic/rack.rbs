module Ratomic
  module Rack
    class Error < StandardError
    end

    class WorkerFactory
      def self.new: () -> WorkerFactory
      def call: () -> Worker
    end

    class Worker
      def call: (untyped application, RequestEnvelope request) -> Array[untyped]
      def close: () -> nil

      private

      def initialize_application: (untyped application) -> void
      def receive_response: (untyped reply) -> Array[untyped]
    end

    class Handler
      def initialize: (untyped application, pool: untyped) -> Handler
      def call: (untyped env) -> Array[untyped]
      def close: () -> nil
    end

    class ResponseEnvelope
      attr_reader status: Integer
      attr_reader headers: Hash[String, String]
      attr_reader body: Array[String]

      def self.from_rack_response: (Array[untyped] response) -> ResponseEnvelope
      def initialize: (Array[untyped] response) -> void
      def to_rack_response: () -> Array[untyped]

      private

      def materialize_body: (untyped body) -> Array[String]
      def copy_headers: (untyped headers) -> Hash[String, String]
    end

    class RequestEnvelope
      HEADER_KEYS: Array[String]
      SELECTED_ENV_KEYS: Array[String]

      attr_reader method: String
      attr_reader path: String
      attr_reader query_string: String
      attr_reader headers: Hash[String, String]
      attr_reader body: String
      attr_reader env_values: Hash[String, untyped]

      def self.from_env: (Hash[untyped, untyped] env) -> RequestEnvelope
      def initialize: (Hash[untyped, untyped] env) -> void
      def to_env: () -> Hash[String, untyped]

      private

      def required_string: (Hash[untyped, untyped] env, String key) -> String
      def optional_string: (Hash[untyped, untyped] env, String key) -> String
      def extract_headers: (Hash[untyped, untyped] env) -> Hash[untyped, untyped]
      def extract_body: (Hash[untyped, untyped] env) -> String
      def extract_env_values: (Hash[untyped, untyped] env) -> Hash[String, untyped]
      def copy_value: (untyped value) -> untyped
      def immutable_string: (untyped value) -> String
      def immutable_string_hash: (Hash[untyped, untyped] values) -> Hash[String, String]
      def immutable_values: (Hash[String, untyped] values) -> Hash[String, untyped]
      def duplicate_values: (Hash[String, untyped] values) -> Hash[String, untyped]
    end

    VERSION: String
  end
end
